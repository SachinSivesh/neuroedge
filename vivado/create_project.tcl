# =============================================================================
# NeuroEdge -- everything inside the Vivado GUI.
#
# Open Vivado 2016 -> Tcl Console (bottom of the start page) -> type:
#     cd E:/BCI-Project/neuroedge/vivado
#     source create_project.tcl
#
# This creates the project in vivado/neuroedge/ with the design and all five
# testbenches. Afterwards, also in the Tcl Console:
#     ne_test tb_iir          run one testbench (tb_iir, tb_encoder, tb_event_cov, tb_ns, tb_top)
#     ne_test_all             run all five, one after another
#     ne_reports              synthesis + implementation + utilization/timing/power reports
# Or use the GUI: Simulation Sources -> right-click a tb -> Set as Top ->
# Flow Navigator -> Run Simulation -> Run Behavioral Simulation.
#
# Next time: File -> Open Project -> vivado/neuroedge/neuroedge.xpr, then in the
# Tcl Console run  source create_project.tcl  again only if you want a fresh
# project (it is recreated from scratch); to just get the commands back:
#     source E:/BCI-Project/neuroedge/vivado/ne_commands.tcl
# =============================================================================
set root [file normalize [file join [file dirname [info script]] ..]]
set inc  [file join $root rtl params]
set vdir [file join $root vivado]

# Path to the test vectors, as a Verilog header the testbenches include
set fh [open [file join $vdir vec_path.vh] w]
puts $fh "// Auto-generated by vivado/create_project.tcl"
puts $fh "`define VEC \"[file join $root vectors]/\""
close $fh

create_project neuroedge [file join $vdir neuroedge] -part xc7z020clg484-1 -force

# ---- design
add_files -norecurse [glob [file join $root rtl *.v]]
add_files -norecurse [glob [file join $inc *.vh]]
set_property file_type {Verilog Header} [get_files -of_objects [get_filesets sources_1] *.vh]
set_property include_dirs $inc [get_filesets sources_1]
set_property top neuroedge_top [get_filesets sources_1]
add_files -fileset constrs_1 -norecurse [file join $vdir neuroedge.xdc]
# measure the core on its own (no I/O pins)
set_property -name {STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS} -value {-mode out_of_context} -objects [get_runs synth_1]

# ---- simulation
add_files -fileset sim_1 -norecurse [glob [file join $root tb tb_*.v]]
add_files -fileset sim_1 -norecurse [file join $vdir vec_path.vh]
set_property file_type {Verilog Header} [get_files -of_objects [get_filesets sim_1] vec_path.vh]
set_property include_dirs [list $inc $vdir] [get_filesets sim_1]
set_property verilog_define {NEUROEDGE_GUI} [get_filesets sim_1]
set_property top tb_iir [get_filesets sim_1]
set_property top_lib xil_defaultlib [get_filesets sim_1]
set_property -name {xsim.simulate.runtime} -value {all} -objects [get_filesets sim_1]

source [file join $vdir ne_commands.tcl]

puts ""
puts "================================================================"
puts " NeuroEdge project ready. In this Tcl Console type:"
puts "   ne_test_all      run all five testbenches (look for PASS)"
puts "   ne_test tb_top   run one testbench"
puts "   ne_reports       utilization, timing and power for the paper"
puts "================================================================"
